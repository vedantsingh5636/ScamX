# ==============================================================================
# ScamX Repository Root .gitignore
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js & Frontend Build Outputs
node_modules/
dist/
dist-ssr/
build/
.output/

# Logs & Debugging
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secret Files (allow .env.example)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# IDE & Editor Directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Explicitly ensure critical ML models and data feeds are tracked
!ml/models/*.joblib
!backend/data/reputation/*.json
